# EITOP environment configuration — copy to .env and adjust.
# NEVER commit the real .env file (.env and .env.* are gitignored).

# --- Application ---
APP_NAME=EITOP
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database ---
# DEV DEFAULTS ONLY — override both for production deployments.
POSTGRES_USER=eitop
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=eitop
DATABASE_URL=postgresql+psycopg://eitop:eitop@localhost:5432/eitop
# Separate database used by the test suite
TEST_DATABASE_URL=postgresql+psycopg://eitop:eitop@localhost:5432/eitop_test
TEST_REDIS_URL=redis://localhost:6379/1

# --- Redis ---
# Used by docker compose for --requirepass; override for production.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://localhost:6379/0

# --- Bootstrap (first admin, used only while the users table is empty) ---
# Prefer env/stdin over argv: never pass passwords as CLI arguments.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# --- Endpoint health (Phase 2.5) ---
# Expected agent heartbeat cadence and the offline threshold (>= interval).
# ENDPOINT_HEARTBEAT_INTERVAL_SECONDS=300
# ENDPOINT_OFFLINE_THRESHOLD_SECONDS=900
# Celery beat cadence for the offline-detection scan.
# ENDPOINT_HEALTH_SCAN_SECONDS=60

# --- Inventory snapshot retention (Phase 2.6) ---
# Days to keep snapshots. Unset = keep history forever (default).
# SNAPSHOT_RETENTION_DAYS=365

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1

# --- Active Directory (Phase 3.1) — uncomment to override defaults ---
# DIRECTORY_CONNECT_TIMEOUT_SECONDS=10
# DIRECTORY_SEARCH_TIMEOUT_SECONDS=30
# DIRECTORY_PAGE_SIZE=500
# DIRECTORY_MISSING_GRACE_DAYS=7
# DIRECTORY_STALE_RUN_MINUTES=30
# DIRECTORY_MAX_SYNC_MINUTES=60
# DIRECTORY_SYNC_LEASE_SECONDS=300
# DIRECTORY_SYNC_SCAN_SECONDS=300

# ===========================================================================
# PRODUCTION
# ===========================================================================
# For production deployments:
#   APP_ENV=production
#   DEBUG=false
#
# With APP_ENV=production the application refuses to start unless ALL of
# these hold (validated by app/core/config.py at boot — API, worker, beat):
#   * DEBUG=false
#   * SECRET_KEY >= 32 chars and not a known placeholder value
#   * DATABASE_URL does not use the development eitop:eitop credentials
#   * Redis URL carries an authentication password (not a dev placeholder)
#   * CORS_ORIGINS: https:// origins only, never "*"
#
# Bootstrap the first administrator WITHOUT touching the shell history:
#   printf '%s' "$BOOTSTRAP_ADMIN_PASSWORD" | \
#     docker compose exec -T backend python -m app.db.seed \
#       --admin-email admin@your-domain.com --admin-password-stdin
# The seed command deliberately has no password CLI argument (argv is
# visible in `ps`). The bootstrap runs only while the users table is empty.
#
# See docs/deployment/README.md for the full production runbook and
# docs/deployment/backup-restore.md for backup/restore procedures.
