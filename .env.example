# EITOP environment configuration — copy to .env and adjust.
# NEVER commit the real .env file.

# --- Application ---
APP_NAME=EITOP
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://eitop:eitop@localhost:5432/eitop
# Separate database used by the test suite
TEST_DATABASE_URL=postgresql+psycopg://eitop:eitop@localhost:5432/eitop_test
TEST_REDIS_URL=redis://localhost:6379/1

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
